# Template - DO NOT commit with real values, and DO NOT `kubectl apply -f`
# this file as-is (it is a comment-only reference, not applyable YAML).
#
# The real Secret is created IMPERATIVELY from a LOCAL team-keys.json
# produced by `scripts/team/issue-key.mjs` (never generated on the cluster
# itself):
#
#   kubectl create secret generic agda-mcp-team-keys \
#     --namespace=llm-gateway \
#     --from-file=team-keys.json=<local-path-to-team-keys.json> \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Adding or revoking a teammate's key requires re-running
# `scripts/team/issue-key.mjs` (issue/revoke) LOCALLY and then re-running
# this SAME sync command — never edit the Secret object directly (a direct
# `kubectl edit secret` would drift from the local team-keys.json SSOT and
# be silently overwritten by the next legitimate sync).
#
# `readKeyRegistry` (scripts/team/issue-key.mjs) always re-reads from disk
# on every request — a Secret-volume update propagates to the NEXT request
# within the kubelet's own sync period, no pod restart required.
#
# Resulting shape (for reference only — never applied literally):
#
# apiVersion: v1
# kind: Secret
# metadata:
#   name: agda-mcp-team-keys
#   namespace: llm-gateway
# type: Opaque
# data:
#   team-keys.json: <base64-encoded contents of the local team-keys.json>
